<Window x:Class="Proyecto_Diseño.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Proyecto_Diseño"
        mc:Ignorable="d"
        Title="MainWindow" Height="655" Width="950">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="623*"/>
            <RowDefinition Height="11*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>

        </Grid.ColumnDefinitions>
        <RichTextBox x:Name="IDE" PreviewKeyDown="IDEKey" BorderBrush="Black" AcceptsTab="True" Margin="139,48,10,169" VerticalScrollBarVisibility="Visible" TextChanged="IDETextChange" Grid.Row="1">
            <RichTextBox.Resources>
                <Style TargetType="{x:Type Paragraph}">
                    <Setter Property="LineHeight" Value="10"></Setter>
                    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"></Setter>
                </Style>
            </RichTextBox.Resources>
            <FlowDocument>
                <Paragraph/>
            </FlowDocument>
        </RichTextBox>
        <Button x:Name="LoginButton" Content="Iniciar sesión" Margin="0,3,372,0" VerticalAlignment="Top" Height="19" Click="Button_Click_1" HorizontalAlignment="Right" Width="72" Grid.RowSpan="2"/>
        <Button x:Name="OpenDoc" Content="Abrir documento" Margin="0,3,273,0" Click="Button_Click" Height="19" VerticalAlignment="Top" Grid.RowSpan="2" HorizontalAlignment="Right" Width="94"/>
        <Button x:Name="SaveButton" Content="Guardar" Margin="0,3,214,0" RenderTransformOrigin="0.48,-0.223" Click="SaveButton_Click" HorizontalAlignment="Right" Width="54" Grid.RowSpan="2" Height="19" VerticalAlignment="Top"/>
        <RichTextBox x:Name="LogTerminal" BorderBrush="Black" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Margin="139,0,10,74" Height="90" VerticalAlignment="Bottom" Grid.Row="1"/>
        <Button Content="Ejecutar " Margin="14,0,0,10" Click="RunScript" HorizontalAlignment="Left" Width="53" Height="23" VerticalAlignment="Bottom" Grid.Row="1" Grid.RowSpan="2"/>
        <RichTextBox x:Name="CommandTerminal" Grid.Row="1" PreviewKeyDown="CmdKeys" Margin="139,0,6,32" Height="37" VerticalAlignment="Bottom"/>
        <Button x:Name="GitButton" Content="Git" Margin="0,0,7,10" Click="GitWindow" HorizontalAlignment="Right" Width="65" Height="22" VerticalAlignment="Bottom" Grid.Row="1" Grid.RowSpan="2"/>
        <Button x:Name="New_File" Content="archivo nuevo" HorizontalAlignment="Right" Margin="0,3,121,0" VerticalAlignment="Top" Width="88" Height="19" Click="NewFile" Grid.RowSpan="2"/>
        <Button x:Name="TareasButton" Content="Mis tareas" HorizontalAlignment="Right" Height="19" Margin="0,3,5,0" VerticalAlignment="Top" Width="89" Click="TareaClick" Grid.RowSpan="2"/>
        <TabControl x:Name="Scriptstab" HorizontalAlignment="Left" Height="21" Margin="139,27,0,0" VerticalAlignment="Top" Width="801" SelectionChanged="ScriptTabChange" Grid.Row="1" >
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding filename}"/>
                </DataTemplate>
            </TabControl.ItemTemplate>
        </TabControl>
        <Button x:Name="ProjectBotton" Content="Abrir proyecto" HorizontalAlignment="Left" Margin="14,4,0,0" Width="88" Click="NewProject" Height="19" VerticalAlignment="Top" Grid.RowSpan="2"/>
        <Button x:Name="RunProject" Content="Run" HorizontalAlignment="Left" Margin="14,23,0,0" VerticalAlignment="Top" Width="42" Grid.Row="1"/>
        <TreeView x:Name="Project" Margin="4,48,0,169" Grid.Row="1" ItemsSource="{Binding ProjectTree}" HorizontalAlignment="Left" Width="130" SelectedItemChanged="OpenProjectScript">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding folder}">
                    <TextBlock Text="{Binding filename}"/>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</Window>
