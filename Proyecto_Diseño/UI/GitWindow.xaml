<Window x:Class="Proyecto_Diseño.UI.GitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Proyecto_Diseño.UI"
        mc:Ignorable="d"
        Title="GitWindow" Height="412" Width="800">
    <Grid Margin="0,0,0,-6">
        <RichTextBox x:Name="LogGit" Margin="10,33,10,220" IsReadOnly="True" VerticalScrollBarVisibility="Auto">
            <RichTextBox.Resources>
                <Style TargetType="{x:Type Paragraph}">
                    <Setter Property="LineHeight" Value="10"></Setter>
                    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"></Setter>
                </Style>
            </RichTextBox.Resources>
        </RichTextBox>
        <Button x:Name="SetDir" Content="Init Directorio" HorizontalAlignment="Left" Height="24" Margin="10,256,0,0" VerticalAlignment="Top" Width="88" Click="ChangeDir"/>
        <Button x:Name="Commit" Content="Commit" HorizontalAlignment="Left" Height="25" Margin="10,285,0,0" VerticalAlignment="Top" Width="88" Click="CommitGit"/>
        <Button x:Name="pull" Content="pull" HorizontalAlignment="Left" Margin="10,315,0,0" VerticalAlignment="Top" Width="88" Height="25" Click="Gitpull"/>
        <Button x:Name="push" Content="push" HorizontalAlignment="Left" Margin="10,345,0,0" VerticalAlignment="Top" Height="25" Width="88" Click="pushgit"/>
        <TextBox x:Name="CommitMessage" HorizontalAlignment="Left" Margin="103,285,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="234" Height="25"/>
        <Button x:Name="CloneRepo" Content="Clone Rep" HorizontalAlignment="Left" Height="25" Margin="10,227,0,0" VerticalAlignment="Top" Width="88" Click="CloreGit"/>
        <TextBox x:Name="Repoclone" HorizontalAlignment="Left" Height="25" Margin="103,227,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="234"/>

    </Grid>
</Window>
