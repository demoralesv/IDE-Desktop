<Window x:Class="Proyecto_Diseño.UI.Mistareas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Proyecto_Diseño.UI"
        mc:Ignorable="d"
        Title="Mis tareas"
        Height="500"
        Width="850"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#DDE6ED">

	<Window.Resources>

		<!-- Colores base -->
		<SolidColorBrush x:Key="PrimaryBrush" Color="#536D82"/>
		<SolidColorBrush x:Key="Extra2Brush" Color="#9DB2BF"/>
		<SolidColorBrush x:Key="Extra1Brush" Color="#26374D"/>
		<SolidColorBrush x:Key="SuccessBrush" Color="#B3DFB3"/>
		<SolidColorBrush x:Key="DangerBrush" Color="#C20000"/>
		<SolidColorBrush x:Key="InfoBrush" Color="#1BBDD6"/>
		<SolidColorBrush x:Key="IconBrush" Color="#17A2B8"/>
		<SolidColorBrush x:Key="IconHoverBrush" Color="#24818F"/>
		<SolidColorBrush x:Key="BackgroundBrush" Color="#DDE6ED"/>
		<SolidColorBrush x:Key="SecondBackgroundBrush" Color="#F5F4F0"/>

		<!-- Texto general -->
		<Style TargetType="TextBlock">
			<Setter Property="FontFamily" Value="Segoe UI"/>
			<Setter Property="Foreground" Value="{StaticResource Extra1Brush}"/>
		</Style>

		<!-- TextBox -->
		<Style TargetType="TextBox">
			<Setter Property="Height" Value="36"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Padding" Value="8"/>
			<Setter Property="Margin" Value="0,4,0,16"/>
			<Setter Property="BorderBrush" Value="{StaticResource Extra2Brush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Background" Value="White"/>
			<Setter Property="Foreground" Value="{StaticResource Extra1Brush}"/>
		</Style>

		<!-- ComboBox -->
		<Style TargetType="ComboBox">
			<Setter Property="Height" Value="36"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Padding" Value="6"/>
			<Setter Property="Margin" Value="0,4,0,16"/>
			<Setter Property="BorderBrush" Value="{StaticResource Extra2Brush}"/>
			<Setter Property="Background" Value="White"/>
			<Setter Property="Foreground" Value="{StaticResource Extra1Brush}"/>
		</Style>

		<!-- RichTextBox -->
		<Style TargetType="RichTextBox">
			<Setter Property="BorderBrush" Value="{StaticResource Extra2Brush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Background" Value="White"/>
			<Setter Property="Foreground" Value="{StaticResource Extra1Brush}"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Padding" Value="8"/>
		</Style>

		<!-- ListBox -->
		<Style TargetType="ListBox">
			<Setter Property="BorderBrush" Value="{StaticResource Extra2Brush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Background" Value="White"/>
			<Setter Property="Padding" Value="8"/>
		</Style>

		<!-- Item de lista -->
		<Style TargetType="ListBoxItem">
			<Setter Property="Margin" Value="0,0,0,8"/>
			<Setter Property="Padding" Value="10"/>
			<Setter Property="Background" Value="White"/>
			<Setter Property="BorderBrush" Value="#E5E7EB"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Cursor" Value="Hand"/>

			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListBoxItem">
						<Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

							<ContentPresenter/>
						</Border>

						<ControlTemplate.Triggers>

							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Extra2Brush}"/>
								<Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
							</Trigger>

							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource PrimaryBrush}"/>
								<Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Extra1Brush}"/>
								<Setter Property="Foreground" Value="White"/>
							</Trigger>

						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

	</Window.Resources>

	<Grid Background="{StaticResource BackgroundBrush}"
          Margin="30">

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="300"/>
			<ColumnDefinition Width="25"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- Panel izquierdo: cursos -->
		<Border Grid.Column="0"
                Background="{StaticResource SecondBackgroundBrush}"
                CornerRadius="14"
                Padding="24">

			<Border.Effect>
				<DropShadowEffect BlurRadius="16"
                                  ShadowDepth="3"
                                  Opacity="0.22"/>
			</Border.Effect>

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<TextBlock Text="Cursos"
                           FontSize="26"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

				<ListBox x:Name="CoursesList"
                         Grid.Row="1">

					<ListBox.ItemTemplate>
						<DataTemplate>
							<StackPanel>
								<TextBlock Text="{Binding nombre}"
                                           FontWeight="Bold"
                                           FontSize="14"/>

								<TextBlock Text="{Binding codigo}"
                                           FontSize="13"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Margin="0,4,0,0"/>
							</StackPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>

				</ListBox>

			</Grid>

		</Border>

		<!-- Panel derecho: tareas -->
		<Border Grid.Column="2"
                Background="{StaticResource SecondBackgroundBrush}"
                CornerRadius="14"
                Padding="28">

			<Border.Effect>
				<DropShadowEffect BlurRadius="16"
                                  ShadowDepth="3"
                                  Opacity="0.22"/>
			</Border.Effect>

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<TextBlock Text="Detalle de tarea"
                           FontSize="26"
                           FontWeight="Bold"
                           Margin="0,0,0,22"/>

				<StackPanel Grid.Row="1">
					<TextBlock Text="Tarea"
                               FontSize="14"
                               FontWeight="SemiBold"/>

					<ComboBox x:Name="Tareascombo"
                              ItemsSource="{Binding ElementName=CoursesList, Path=SelectedItem.tareas}"
                              DisplayMemberPath="titulo"
                              SelectionChanged="TareaSelect"/>
				</StackPanel>

				<StackPanel Grid.Row="2">
					<TextBlock Text="Descripción"
                               FontSize="14"
                               FontWeight="SemiBold"/>

					<RichTextBox x:Name="TareaDescrip"
                                 Height="170"
                                 Margin="0,4,0,16"
                                 IsReadOnly="True"/>
				</StackPanel>

				<StackPanel Grid.Row="3">
					<TextBlock Text="Adjunto"
                               FontSize="14"
                               FontWeight="SemiBold"/>

					<TextBox x:Name="AdjuntoBox"
                             IsReadOnly="True"/>
				</StackPanel>

				<StackPanel Grid.Row="4">
					<TextBlock Text="Fecha de entrega"
                               FontSize="14"
                               FontWeight="SemiBold"/>

					<TextBox x:Name="DateBox"
                             IsReadOnly="True"/>
				</StackPanel>

			</Grid>

		</Border>

	</Grid>
</Window>