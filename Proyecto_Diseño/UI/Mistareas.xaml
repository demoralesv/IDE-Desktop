<Window x:Class="Proyecto_Diseño.UI.Mistareas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Proyecto_Diseño.UI"
        mc:Ignorable="d"
        Title="Mis tareas"
        Height="500"
        Width="850"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#DDE6ED">
    <Grid>
        <ListBox x:Name="CoursesList" HorizontalAlignment="Left" Height="165" Margin="40,0,0,0" VerticalAlignment="Center" Width="205">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding nombre}" FontWeight="Bold" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding codigo}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <RichTextBox x:Name="TareaDescrip" HorizontalAlignment="Left" Height="153" Margin="478,137,0,0" VerticalAlignment="Top" Width="239">
        </RichTextBox>
        <TextBox x:Name="AdjuntoBox" HorizontalAlignment="Left" Margin="478,295,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="239" Height="20" />
        <TextBox x:Name="DateBox" HorizontalAlignment="Left" Height="20" Margin="478,320,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="239" RenderTransformOrigin="0.164,-0.303"/>
        <ComboBox x:Name="Tareascombo" HorizontalAlignment="Left" Height="21" Margin="484,73,0,0" VerticalAlignment="Top" Width="155" ItemsSource="{Binding ElementName=CoursesList, Path=SelectedItem.tareas}" DisplayMemberPath="titulo" SelectionChanged="TareaSelect"/>
        <Label x:Name="DescriptLabel" Content="Descripción" HorizontalAlignment="Left" Height="25" Margin="473,112,0,0" VerticalAlignment="Top" Width="77"/>
        <Label x:Name="AdjuntoLabel" Content="Adjunto" HorizontalAlignment="Left" Margin="422,291,0,0" VerticalAlignment="Top"/>
        <Label Content="Fecha de Entrega" HorizontalAlignment="Left" Height="26" Margin="373,316,0,0" VerticalAlignment="Top" Width="102"/>
        <ListBox x:Name="Groups" HorizontalAlignment="Left" Height="79" Margin="478,345,0,0" VerticalAlignment="Top" Width="239" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} {1}">
                                    <Binding Path="nombre"/>
                                    <Binding Path="apellido1"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <ListBox x:Name="submissions" HorizontalAlignment="Left" Height="79" Margin="45,345,0,0" VerticalAlignment="Top" Width="200" d:ItemsSource="{d:SampleData ItemCount=5}"/>
        <Button x:Name="Submit" Content="Entregar Tarea" HorizontalAlignment="Left" Height="23" Margin="250,401,0,0" VerticalAlignment="Top" Width="93" Click="SubmitWork"/>


    </Grid>
</Window>